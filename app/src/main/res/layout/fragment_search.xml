<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <EditText
        android:id="@+id/etRoad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Road name, e.g. A83"
        android:inputType="text"
        android:imeOptions="actionDone|flagNoExtractUi"/>

    <EditText
        android:id="@+id/etDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Distance in km from GCU, e.g. 10"
        android:inputType="numberDecimal"
        android:imeOptions="actionDone|flagNoExtractUi"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/searchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search road" />

        <Button
            android:id="@+id/nearButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Near GCU" />

        <Button
            android:id="@+id/showAllButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show all" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSearchInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:text="Showing all situations" />
</LinearLayout>